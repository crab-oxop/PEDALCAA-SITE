// Prisma schema for PedalCAA job requests
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// SQLite has no enum support, so status/tier/time fields are plain strings.
// Treat them as unions of the string literals defined in src/lib/types.ts.
model JobRequest {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Customer info
  name    String
  phone   String
  email   String?
  address String

  // Issue
  issueType    String
  issueDetails String?
  photoUrl     String?

  // Timing: "asap" | "scheduled"
  preferredTime String
  scheduledFor  DateTime?

  // Pricing: "emergency" | "scheduled"
  serviceTier      String
  dispatchFeeCents Int

  // status: "pending_payment" | "confirmed" | "dispatched" | "completed" | "cancelled"
  status String @default("pending_payment")

  stripeSessionId     String? @unique
  stripePaymentStatus String? // "unpaid" | "paid" | "failed"

  notes String?
}

model Review {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  name    String
  rating  Int // 1-5
  comment String

  // Reviews are visible immediately; admin can delete anything inappropriate
  // after the fact rather than pre-moderating every submission.
  hidden Boolean @default(false)
}
